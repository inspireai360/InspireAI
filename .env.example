# ─────────────────────────────────────────────────────────────────────────────
# InspireAI — Variables de entorno
# Copia este archivo como .env.local y rellena los valores reales.
# NUNCA subas .env.local al repositorio (ya está en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Airtable ─────────────────────────────────────────────────────────────────
# Token personal de Airtable (empieza por "pat")
AIRTABLE_TOKEN=patXXXXXXXXXXXXXX

# ID de la base de Airtable (empieza por "app")
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Nombre exacto de la tabla de leads del formulario público
AIRTABLE_LEADS_TABLE=Leads

# Nombres exactos de las 4 tablas de onboarding
AIRTABLE_TABLE_VENTAS=Ventas
AIRTABLE_TABLE_MARKETING=Marketing
AIRTABLE_TABLE_OPERACIONES=Operaciones
AIRTABLE_TABLE_DELIVERY=Delivery

# ── Supabase ─────────────────────────────────────────────────────────────────
# URL de tu proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Clave de servicio de Supabase (SERVICE ROLE) para uso server-side
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# URL base de la aplicación, usada para validar peticiones de origen y CSRF básico.
# En producción debe coincidir con el dominio público de la web.
APP_ORIGIN=https://inspireai.es

# Resend: clave API para enviar notificaciones por email
# Si no la provees, los emails de notificación no se enviarán.
RESEND_API_KEY=key_xxxxxxxxxxxxxxxxxxxxx

# ── Onboarding ────────────────────────────────────────────────────────────────
# Clave de acceso para los cuestionarios de onboarding.
# Usa una cadena aleatoria y segura (min. 16 caracteres).
# Ejemplo de clave: InspireAI-2024-XkQ9
ONBOARDING_ACCESS_KEY=
